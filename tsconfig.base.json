// The checking rules every workspace inherits. Deliberately says nothing about
// `target`, `lib`, `module` or emit: those differ per workspace and each one
// records its own reason.
{
    "compilerOptions": {
        /* Type Checking - Base */
        /*
         * `strict` covers noImplicitAny, noImplicitThis, strictNullChecks,
         * strictFunctionTypes, strictBindCallApply, strictPropertyInitialization,
         * useUnknownInCatchVariables, strictBuiltinIteratorReturn and alwaysStrict.
         */
        "strict": true,

        /* Type Checking - Additional Strictness */
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,

        /* Specific Behaviors */
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,

        /* Module System */
        "esModuleInterop": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,

        /* Library & Syntax */
        "erasableSyntaxOnly": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true // Third-party `.d.ts` files are not mine to fix; checking them only surfaces bugs in published packages, never in this repo
    }
}
