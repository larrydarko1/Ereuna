{
    /* The Vue preset supplies the DOM environment (target, lib, jsx); the base
       config supplies the strictness rules. Later entries win, so the base has
       the final say on any checking flag the preset also sets. */
    "extends": ["@vue/tsconfig/tsconfig.dom.json", "../tsconfig.base.json"],
    "compilerOptions": {
        /* Output & Build */
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

        /* Paths & Types */
        "paths": {
            "@/*": ["./src/*"]
        },
        /* `node` is here for packages/shared, not for anything in src/: the
           shared package is consumed as TypeScript source, so this project
           type-checks its files, and its env config reads `process.env`. */
        "types": ["vite/client", "node"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
