{
    "name": "frontend",
    "version": "2026.6",
    "description": "Ereuna web client — Vue 3, vue-i18n, and a forked lightweight-charts single-page app.",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
        "stylelint": "stylelint \"src/**/*.scss\" \"src/**/*.vue\" --ignore-pattern \"src/components/charts/**\"",
        "stylelint:fix": "stylelint \"src/**/*.scss\" \"src/**/*.vue\" --ignore-pattern \"src/components/charts/**\" --fix"
    },
    "dependencies": {
        "@ereuna/shared": "*",
        "axios": "^1.20.0",
        "fancy-canvas": "^2.1.0",
        "qrcode.vue": "^3.10.0",
        "socket.io-client": "^4.8.3",
        "vue": "^3.5.42",
        "vue-i18n": "^11.4.10",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/tsconfig": "^0.9.1",
        "autoprefixer": "^10.5.4",
        "postcss-html": "^2.0.0",
        "sass-embedded": "^1.103.1",
        "stylelint": "^17.14.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-declaration-strict-value": "^1.12.1",
        "stylelint-scss": "^7.2.0",
        "typescript": "~6.0.2",
        "vite": "^8.2.2",
        "vue-tsc": "^3.3.11"
    },
    "private": true,
    "browserslist": [
        "defaults",
        "Safari >= 14",
        "iOS >= 14"
    ]
