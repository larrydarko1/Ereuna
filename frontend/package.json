{
    "name": "frontend",
    "version": "2026.8.0",
    "description": "Ereuna web client — a Vue 3, vue-i18n single-page app with its own charting layer.",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
        "stylelint": "stylelint \"src/**/*.scss\" \"src/**/*.vue\" --ignore-pattern \"src/components/charts/**\"",
        "stylelint:fix": "stylelint \"src/**/*.scss\" \"src/**/*.vue\" --ignore-pattern \"src/components/charts/**\" --fix"
    },
    "dependencies": {
        "@ereuna/shared": "*",
        "axios": "^1.20.0",
        "fancy-canvas": "^2.1.0",
        "qrcode.vue": "^3.10.0",
        "socket.io-client": "^4.8.4",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.16",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "autoprefixer": "^10.6.1",
        "sass-embedded": "^1.106.1",
        "typescript": "~6.0.2",
        "vite": "^8.3.0",
        "vue-tsc": "^3.3.13"
    },
    "private": true,
    "browserslist": [
        "defaults",
        "Safari >= 14",
        "iOS >= 14"
    ]
}
