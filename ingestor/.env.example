# Ereuna ingestor — copy to .env and fill in.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=EreunaDB

REDIS_HOST=localhost
REDIS_PORT=6379

# The market-data vendor. No default: the service has nothing to ingest without it.
TIINGO_KEY=

# Liveness and Prometheus. METRICS_TOKEN is optional; unset serves /metrics open.
PROBE_PORT=9092
METRICS_TOKEN=
