# Ereuna ingestor — copy to .env and fill in.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=EreunaDB

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Also write every log line, as JSON, to this file. Leave blank for stdout only.
LOG_FILE=

REDIS_HOST=localhost
REDIS_PORT=6379
# Which numbered Redis database, 0 by default. `npm run dev:sim` sets its own
# REDIS_DB=0

# The market-data vendor. No default: the service has nothing to ingest without it.
TIINGO_KEY=

# The vendor's trade websocket. Blank means Tiingo's own feed; `npm run dev:ingestor:sim`
# points it at the local feed simulator instead. Production refuses anything but wss://.
TIINGO_URL=

# Liveness and Prometheus. METRICS_TOKEN guards /metrics, at least 32 characters;
# required in production, and unset elsewhere it serves /metrics open.
PROBE_PORT=9092
METRICS_TOKEN=
