{
    "name": "ingestor",
    "version": "2026.11.0",
    "description": "Ereuna ingestor service — Tiingo websocket intake fanned into Redis for the aggregator.",
    "license": "UNLICENSED",
    "author": "Lorenzo Mazzola",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:sim": "TIINGO_URL=ws://localhost:8787 TIINGO_KEY=simulated tsx watch src/index.ts",
        "sim": "TIINGO_KEY=simulated tsx src/simulator/index.ts",
        "build": "tsc && tsc-alias",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ereuna/shared": "*",
        "dotenv": "^18.0.9",
        "ioredis": "^6.0.0",
        "mongodb": "^7.7.0",
        "prom-client": "^15.1.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/ws": "^8.18.1",
        "tsc-alias": "^1.9.4",
        "tsx": "^4.23.13",
        "typescript": "~6.0.2",
        "ws": "^8.21.3"
    },
    "engines": {
        "node": ">=26"
    },
    "private": true
}
