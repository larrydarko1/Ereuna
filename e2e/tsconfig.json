{
    "compilerOptions": {
        "target": "ES2025",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2025", "DOM"],
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["**/*.ts"]
}
