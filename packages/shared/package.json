{
    "name": "@ereuna/shared",
    "version": "2026.8.0",
    "description": "Cross-workspace contracts shared by the Ereuna api, ingestor, aggregator and frontend — the HTTP contract with its request and response schemas, the socket events, error codes, limits, env schema fragments, collection types, the realtime feed contract, and the screener filter registry.",
    "license": "UNLICENSED",
    "author": "Lorenzo Mazzola",
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./contract-coverage": "./src/contract-coverage.ts",
        "./openapi": "./src/openapi.ts",
        "./logger": "./src/logger.ts",
        "./db/collections": "./src/db/collections.ts",
        "./db/indexes": "./src/db/indexes.ts",
        "./screener/filters": "./src/screener/filters.ts",
        "./service/connections": "./src/service/connections.ts",
        "./service/probes": "./src/service/probes.ts"
    },
    "sideEffects": false,
    "imports": {
        "#*": "./src/*"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/larrydarko1/Ereuna.git"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "pino": "^10.4.0",
        "prom-client": "^15.1.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "ioredis": "^6.0.0",
        "mongodb": "^7.7.0",
        "pino-pretty": "^13.2.0",
        "typescript": "~6.0.2",
        "vitest": "^5.0.5",
        "zod-openapi": "^6.0.2"
    },
    "engines": {
        "node": ">=24"
    },
    "private": true
}
