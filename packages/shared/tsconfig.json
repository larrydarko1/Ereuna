// Cross-workspace contracts. Nothing compiles this package: every consumer
// reads it as TypeScript source — the frontend transpiles it, the backends run
// it through tsx — so there is no emit, no `outDir` and no `declaration`. That
// is the whole reason `exports` points at `./src/*.ts`.
{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        /* Target & Environment */
        "target": "ES2025",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2025"],

        /* Paths & Types */
        "rootDir": "src",
        "types": ["node"]
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}
