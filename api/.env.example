# Ereuna API — copy to .env and fill in. No real values belong in this file.

# Server
NODE_ENV=development
PORT=5500
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3500
# Number of reverse-proxy hops in front of the API. Never set this to `true`.
TRUST_PROXY_HOPS=1

# Auth — no defaults; the process refuses to start without these.
# JWT_SECRET is any string of 32+ chars. TOTP_ENCRYPTION_KEY is an AES-256 key
# and must be exactly 64 hex chars (32 bytes): openssl rand -hex 32
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Ereuna

# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DB=EreunaDB

# Redis — cache, rate limiting, login throttle
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Bearer token guarding /metrics. Unset leaves the endpoint open.
METRICS_TOKEN=
