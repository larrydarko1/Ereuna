{
    "name": "ereuna",
    "version": "2026.8",
    "description": "Web app for screening and researching financial markets",
    "keywords": [
        "stock-market",
        "portfolio-simulation",
        "finance",
        "screening",
        "vue",
        "typescript"
    ],
    "homepage": "https://github.com/larrydarko1/Ereuna#readme",
    "bugs": {
        "url": "https://github.com/larrydarko1/Ereuna/issues"
    },
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "Lorenzo Mazzola",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/larrydarko1/Ereuna.git"
    },
    "scripts": {
        "dev": "concurrently -n front,api -c blue,green \"npm run dev:frontend\" \"npm run dev:api\"",
        "dev:frontend": "npm -w frontend run dev",
        "dev:api": "npm -w api run dev",
        "dev:worker": "npm -w worker run dev",
        "dev:ingestor": "npm -w ingestor run dev",
        "build:all": "npm -w frontend run build && npm -w api run build && npm -w ingestor run build && npm -w worker run build",
        "format": "prettier --write \"**/*.{ts,vue,scss,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,vue,scss,json,md}\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "npm -w packages/shared run typecheck && npm -w api run typecheck && npm -w ingestor run typecheck && npm -w worker run typecheck",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "test:e2e:report": "playwright show-report playwright-report",
        "audit:check": "node scripts/checks/check-audit.mjs",
        "pkg:check": "node scripts/checks/check-package-json.mjs",
        "env:check": "node scripts/checks/check-env-drift.mjs",
        "style:check": "node scripts/checks/check-code-style.mjs",
        "declorder:check": "node scripts/checks/check-declaration-order.mjs",
        "refactor:check": "node scripts/checks/check-refactoring.mjs",
        "i18n:check": "node scripts/checks/check-i18n.mjs",
        "html:check": "node scripts/checks/check-html-standards.mjs",
        "scss:check": "node scripts/checks/check-scss-standards.mjs",
        "api:check": "node scripts/checks/check-api-standards.mjs",
        "ws:check": "node scripts/checks/check-ws-standards.mjs",
        "err:check": "node scripts/checks/check-error-handling.mjs",
        "sec:check": "node scripts/checks/check-security-drift.mjs",
        "db:check": "node scripts/checks/check-db-drift.mjs",
        "dead:check": "node scripts/checks/check-dead-code.mjs",
        "dup:check": "node scripts/checks/check-duplication.mjs",
        "test:check": "node scripts/checks/check-testing.mjs",
        "lint:dead": "knip --no-progress --tags=-public --include files,exports,types,nsExports,nsTypes,namespaceMembers,enumMembers,duplicates,dependencies,devDependencies,optionalPeerDependencies",
        "lint:dup": "jscpd frontend/src api/src worker/src ingestor/src packages/shared/src --config .jscpd.json --absolute --reporters console",
        "ci:check": "npm run audit:check && npm run pkg:check && npm run env:check && npm run style:check && npm run declorder:check && npm run refactor:check && npm run i18n:check && npm run html:check && npm run scss:check && npm run api:check && npm run ws:check && npm run err:check && npm run sec:check && npm run db:check && npm run dead:check && npm run dup:check && npm run format:check && npm run lint && npm -w frontend run stylelint && npm run typecheck && npm run build:all && npm run test:coverage && npm run test:check && npm run test:e2e",
        "preview": "npm -w frontend run preview",
        "worker": "npm -w worker run dev",
        "worker:aggregate": "npm -w worker run dev:aggregate",
        "worker:organize": "npm -w worker run dev:organize",
        "ingestor": "npm -w ingestor run dev",
        "dbstart": "brew services start mongodb-community",
        "dbstop": "brew services stop mongodb-community",
        "db:migrate": "npm -w db run migrate:up",
        "db:migrate:status": "npm -w db run migrate:status",
        "db:migrate:create": "npm -w db run migrate:create --",
        "db:checksums": "node scripts/write-migration-checksums.mjs",
        "redisstart": "brew services start redis",
        "redisstop": "brew services stop redis",
        "redis": "redis-server"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
        "@playwright/test": "^1.63.0",
        "@vitest/coverage-v8": "^4.1.9",
        "@vitest/eslint-plugin": "^1.6.24",
        "@vue/compiler-sfc": "^3.5.41",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^10.0.5",
        "dotenv": "^17.4.2",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.9.2",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "globals": "^17.12.0",
        "jscpd": "^5.1.2",
        "jsdom": "^29.1.1",
        "knip": "^6.34.0",
        "msw": "^2.15.0",
        "prettier": "^3.9.6",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.1",
        "vitest": "^4.1.11"
    },
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=24"
    },
    "private": true,
    "workspaces": [
        "packages/shared",
        "frontend",
        "api",
        "worker",
        "ingestor",
        "db"
    ]
}
