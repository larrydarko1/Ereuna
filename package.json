{
    "name": "ereuna",
    "version": "2026.5",
    "description": "Web app for screening and researching financial markets",
    "homepage": "https://github.com/larrydarko1/Ereuna#readme",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "Lorenzo Mazzola",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/larrydarko1/Ereuna.git"
    },
    "bugs": {
        "url": "https://github.com/larrydarko1/Ereuna/issues"
    },
    "keywords": [
        "stock-market",
        "portfolio-simulation",
        "finance",
        "screening",
        "vue",
        "typescript"
    ],
    "scripts": {
        "dev": "concurrently -n front,api,aggr,ingest -c blue,green,yellow,magenta \"npm run dev:frontend\" \"npm run dev:api\" \"npm run dev:aggregator\" \"npm run dev:ingestor\"",
        "dev:frontend": "npm -w frontend run dev",
        "dev:api": "npm -w api run dev",
        "dev:aggregator": "npm -w aggregator run dev",
        "dev:ingestor": "npm -w ingestor run dev",
        "dev:websocket": "npm -w aggregator run dev:websocket",
        "build:all": "npm -w frontend run build && npm -w api run build",
        "preview": "npm -w frontend run preview",
        "aggregator": "npm -w aggregator run start",
        "ingestor": "npm -w ingestor run start",
        "websocket": "npm -w aggregator run start:websocket",
        "py:install": "npm -w aggregator run py:install && npm -w ingestor run py:install",
        "dbstart": "brew services start mongodb-community@7.0",
        "dbstop": "brew services stop mongodb-community@7.0",
        "dbup": "npm -w db run restore",
        "dbdump": "npm -w db run dump",
        "redisstart": "brew services start redis",
        "redisstop": "brew services stop redis",
        "redis": "redis-server"
    },
    "devDependencies": {
        "concurrently": "^10.0.3",
        "typescript": "~5.9.2"
    },
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=24"
    },
    "private": true,
    "workspaces": [
        "packages/shared",
        "frontend",
        "api",
        "aggregator",
        "ingestor",
        "db"
    ]
}
