{
    "name": "ereuna",
    "version": "2026.5",
    "description": "Web app for screening and researching financial markets",
    "homepage": "https://github.com/larrydarko1/Ereuna#readme",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "Lorenzo Mazzola",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/larrydarko1/Ereuna.git"
    },
    "bugs": {
        "url": "https://github.com/larrydarko1/Ereuna/issues"
    },
    "keywords": [
        "stock-market",
        "portfolio-simulation",
        "finance",
        "screening",
        "vue",
        "typescript"
    ],
    "scripts": {
        "dev": "concurrently -n front,api -c blue,green \"npm run dev:frontend\" \"npm run dev:api\"",
        "dev:frontend": "npm -w frontend run dev",
        "dev:api": "npm -w api run dev",
        "dev:worker": "npm -w worker run dev",
        "dev:ingestor": "npm -w ingestor run dev",
        "build:all": "npm -w frontend run build && npm -w api run build && npm -w ingestor run build && npm -w worker run build",
        "typecheck": "npm -w packages/shared run typecheck && npm -w api run typecheck && npm -w ingestor run typecheck && npm -w worker run typecheck",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "preview": "npm -w frontend run preview",
        "worker": "npm -w worker run start",
        "worker:aggregate": "npm -w worker run start:aggregate",
        "worker:organize": "npm -w worker run start:organize",
        "ingestor": "npm -w ingestor run start",
        "dbstart": "brew services start mongodb-community",
        "dbstop": "brew services stop mongodb-community",
        "dbup": "npm -w db run restore",
        "dbdump": "npm -w db run dump",
        "redisstart": "brew services start redis",
        "redisstop": "brew services stop redis",
        "redis": "redis-server"
    },
    "devDependencies": {
        "concurrently": "^10.0.5",
        "typescript": "~6.0.2",
        "vitest": "^4.1.11"
    },
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=26"
    },
    "private": true,
    "workspaces": [
        "packages/shared",
        "frontend",
        "api",
        "worker",
        "ingestor",
        "db"
    ]
}
