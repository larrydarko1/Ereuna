{
    "name": "ereuna",
    "version": "2026.10.2",
    "description": "Web app for screening and researching financial markets",
    "keywords": [
        "stock-market",
        "portfolio-simulation",
        "finance",
        "screening",
        "vue",
        "typescript"
    ],
    "homepage": "https://github.com/larrydarko1/Ereuna#readme",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": {
        "name": "Lorenzo Mazzola",
        "email": "hello@larrydarko.dev"
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/larrydarko1/Ereuna.git"
    },
    "scripts": {
        "dev": "concurrently -n front,api -c blue,green \"npm run dev:frontend\" \"npm run dev:api\"",
        "dev:frontend": "npm -w frontend run dev",
        "dev:api": "npm -w api run dev",
        "dev:worker": "npm -w worker run dev",
        "dev:ingestor": "npm -w ingestor run dev",
        "build:all": "npm -w frontend run build && npm -w api run build && npm -w ingestor run build && npm -w worker run build",
        "format": "prettier --write \"**/*.{ts,vue,scss,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,vue,scss,json,md}\"",
        "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js .",
        "lint:fix": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --fix",
        "typecheck": "npm -w packages/shared run typecheck && npm -w api run typecheck && npm -w ingestor run typecheck && npm -w worker run typecheck && npm -w frontend run typecheck && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "test:e2e:report": "playwright show-report playwright-report",
        "test:fuzz": "tsx e2e/fuzz/run.ts",
        "ci:check": "npm run format:check && npm run lint && npm -w frontend run stylelint && npm run typecheck && npm run build:all && npm run test:coverage && npm run check && npm run test:e2e",
        "preview": "npm -w frontend run preview",
        "worker": "npm -w worker run dev",
        "worker:aggregate": "npm -w worker run dev:aggregate",
        "worker:organize": "npm -w worker run dev:organize",
        "ingestor": "npm -w ingestor run dev",
        "dbstart": "brew services start mongodb-community",
        "dbstop": "brew services stop mongodb-community",
        "db:migrate": "npm -w db run migrate:up",
        "db:migrate:status": "npm -w db run migrate:status",
        "db:migrate:create": "npm -w db run migrate:create --",
        "db:checksums": "node scripts/write-migration-checksums.ts",
        "backup": "node scripts/backup.ts",
        "restore": "node scripts/restore.ts",
        "redisstart": "brew services start redis",
        "redisstop": "brew services stop redis",
        "redis": "redis-server",
        "prepare": "husky",
        "check": "larry check"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@larrydarko/lint-config": "^0.1.0-beta.10",
        "@playwright/test": "^1.64.1",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.5",
        "dotenv": "^18.0.9",
        "ioredis": "^6.0.0",
        "jsdom": "^30.1.3",
        "mongodb": "^7.7.0",
        "msw": "^2.15.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.5"
    },
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=24"
    },
    "private": true,
    "workspaces": [
        "packages/shared",
        "frontend",
        "api",
        "worker",
        "ingestor",
        "db"
    ]
}
