# Ereuna worker — copy to .env and fill in.

# all | aggregate | organize. `all` runs both jobs in one process, which is the
# single-host default; a cluster runs one Deployment per role off this image.
WORKER_ROLE=all

MONGO_URI=mongodb://localhost:27017
MONGO_DB=EreunaDB

# Only the aggregate role uses Redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# The market-data vendor. Required unless WORKER_ROLE=aggregate, which never
# calls it.
TIINGO_KEY=

# Run the nightly batch once at startup instead of waiting for 19:00 New York.
# For a manual catch-up; leave false in a deployment.
ORGANIZE_ON_START=false

# Liveness and Prometheus. METRICS_TOKEN is optional; unset serves /metrics open.
PROBE_PORT=9093
METRICS_TOKEN=
