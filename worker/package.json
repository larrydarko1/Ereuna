{
    "name": "worker",
    "version": "2026.7",
    "description": "Ereuna worker — the live trade aggregator and the nightly derived-data batch, scoped by WORKER_ROLE.",
    "license": "UNLICENSED",
    "author": "Lorenzo Mazzola",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "start:aggregate": "WORKER_ROLE=aggregate node dist/index.js",
        "start:organize": "WORKER_ROLE=organize node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@ereuna/shared": "*",
        "dotenv": "^17.4.2",
        "ioredis": "^6.0.0",
        "mongodb": "^7.6.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "tsc-alias": "^1.9.4",
        "tsx": "^4.23.13",
        "typescript": "~6.0.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=24"
    },
    "private": true
}
