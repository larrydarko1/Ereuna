{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        /* Output & Build */
        "outDir": "dist",
        "rootDir": "src",

        /* Target & Environment */
        "target": "ES2025",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2025"],

        /* Paths & Types */
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
